# Copy to .env.local for `npm run dev`. Free services only.

# Where the backend stack (Caddy) runs; dev rewrites send /api and /test-inbox there.
BACKEND_URL=http://localhost:8080

# Show the TEST MODE banner (prototype). Set to "false" only outside the prototype.
NEXT_PUBLIC_TEST_MODE=true

# Server-only key shared with the API (INTERNAL_API_KEY there): page rendering
# calls skip the per-visitor rate limit. Leave empty locally.
INTERNAL_API_KEY=
